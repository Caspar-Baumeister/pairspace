# Public site URL, used for canonical tags, sitemap and the shareable event link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config, Project settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to point the app at the local Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=0

# Server side admin credentials, only needed for server rendering of public event pages
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloud Functions secrets, set with: firebase functions:secrets:set RESEND_API_KEY
# RESEND_API_KEY=
# MAIL_FROM=Pairspace <hello@yourdomain.com>
