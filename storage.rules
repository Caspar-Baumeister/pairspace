rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * Participant photos. One object per participant, named by their auth uid,
     * so a person can only ever overwrite their own picture. Anyone holding the
     * event link may read, which is the same audience that can see the profile.
     */
    match /events/{eventId}/participants/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.webp'
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/webp';

      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.webp';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
