rules_version = '2';

/**
 * Every path carries the uid of the person allowed to write it, so the rules
 * never need to look into Firestore. Reads go through download URLs, which
 * carry their own token, so read here only covers the SDK.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
          && request.resource.contentType == 'image/webp';
    }

    // Room photos and the landlord portrait.
    match /landlords/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && validImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Applicant photos, only for the flat they applied to.
    match /flats/{flatId}/applicants/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && validImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
