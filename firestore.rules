rules_version = '2';

/**
 * Pairspace, flatmate matching. The layout is documented in src/lib/types.ts.
 *
 * Who sees what
 *   landlord      everything about their own flats
 *   applicant     the live flat, the profiles of the other applicants of that
 *                 flat, and only their own ballot and contact details
 *   anyone else   a live flat (it is linked from public ads anyway)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function permanent() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function flatData(flatId) {
      return get(/databases/$(database)/documents/flats/$(flatId)).data;
    }

    function ownsFlat(flatId) {
      return signedIn() && flatData(flatId).ownerUid == request.auth.uid;
    }

    function flatIsLive(flatId) {
      return flatData(flatId).status == 'live';
    }

    /** Trial or paid. Written by the server only, see /api/abo. */
    function subscribed() {
      let sub = get(/databases/$(database)/documents/landlords/$(request.auth.uid)).data.get('subscription', null);
      return sub != null
        && sub.status in ['trialing', 'active']
        && sub.currentPeriodEnd > request.time.toMillis();
    }

    function validRooms(data) {
      return data.rooms is list && data.rooms.size() <= 100;
    }

    match /landlords/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if permanent()
                    && request.auth.uid == uid
                    && !('subscription' in request.resource.data);
      allow update: if permanent()
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'uid']);
    }

    match /flats/{flatId} {
      allow read: if resource.data.status == 'live'
                  || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if permanent()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id == flatId
                    && request.resource.data.status == 'draft'
                    && validRooms(request.resource.data);

      // Going live needs a trial or a paid plan. That is what unlocks the link.
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.id == resource.data.id
                    && validRooms(request.resource.data)
                    && (request.resource.data.status != 'live' || subscribed());

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /applicants/{uid} {
        allow read: if signedIn() && (flatIsLive(flatId) || ownsFlat(flatId));
        allow create, update: if signedIn()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && request.resource.data.photos.size() <= 6
                              && request.resource.data.bio.size() <= 1000
                              && flatIsLive(flatId);
        allow delete: if signedIn() && (request.auth.uid == uid || ownsFlat(flatId));

        match /private/{docId} {
          allow read: if signedIn() && (request.auth.uid == uid || ownsFlat(flatId));
          allow create, update: if signedIn() && request.auth.uid == uid && flatIsLive(flatId);
          allow delete: if signedIn() && (request.auth.uid == uid || ownsFlat(flatId));
        }
      }

      // Ratings and room wishes never reach the other applicants.
      match /ballots/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || ownsFlat(flatId));
        allow create, update: if signedIn()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid
                              && request.resource.data.votes is map
                              && request.resource.data.roomRanks is map
                              && flatIsLive(flatId);
        allow delete: if signedIn() && (request.auth.uid == uid || ownsFlat(flatId));
      }
    }

    // Wishes, feedback and bugs from landlords and applicants. Write once, read
    // only by the server, which mails each one to Caspar.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'email', 'source', 'flatId', 'page', 'locale', 'userAgent', 'createdAt'])
                    && request.resource.data.kind in ['idea', 'feedback', 'bug']
                    && request.resource.data.source in ['landlord', 'applicant']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 4000
                    && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
                    && (request.resource.data.flatId == null || (request.resource.data.flatId is string && request.resource.data.flatId.size() <= 60))
                    && request.resource.data.page is string && request.resource.data.page.size() <= 300
                    && request.resource.data.locale in ['de', 'en']
                    && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
                    && request.resource.data.createdAt is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
